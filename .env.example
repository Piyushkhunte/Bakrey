# Set these in Vercel Project Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
GEMINI_API_KEY=your-server-only-gemini-api-key
# Optional; defaults to gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
# Configure these with an India-compatible SMS provider and approved DLT template.
SMS_API_URL=https://your-sms-provider.example/send
SMS_API_KEY=your-server-only-sms-api-key
SMS_SENDER_ID=your-approved-sender-id
SMS_TEMPLATE_ID=your-approved-template-id
